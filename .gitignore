nbproject/private/

# --- OS -------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs -----------------------------------------------------------------
*.log
logs/

# --- Burp Suite -----------------------------------------------------------
# Burp project files contain this extension's stored extension data, which
# includes the TOTP secrets in plaintext. Never commit them.
*.burp
*.burp.bak
*.burp.tmp

# --- Exported 2FA accounts (SECRETS - never commit) -----------------------
# Files produced by the extension's Export feature. Encrypted or not, these
# hold shared secrets and must not end up in version control.
*.2fa.json
2fa-accounts-*.txt
2fa-accounts-*.json
2fa-accounts-*.2fa.json
